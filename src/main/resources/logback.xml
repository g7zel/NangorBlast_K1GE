<configuration>
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>logs/nangor-blast.log</file>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>
  <!-- Log ke file saja agar tidak merusak tampilan terminal game -->
  <root level="INFO">
    <appender-ref ref="FILE"/>
  </root>
</configuration>
